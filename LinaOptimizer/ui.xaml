<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lina Optimizer"
        Width="1280" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0E1B2E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF31C8FF" />
        <SolidColorBrush x:Key="GlowBrush" Color="#FF3BE9FF" />
        <SolidColorBrush x:Key="CardBrush" Color="#FF11243D" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFEAF4FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9BB2CC" />
        <DropShadowEffect x:Key="NeonGlow" Color="#FF2EDBFF" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1F3C62" />
                                <Setter Property="Effect" Value="{StaticResource NeonGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF04141F" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Effect="{StaticResource NeonGlow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource GlowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect" Value="{StaticResource NeonGlow}" />
        </Style>
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="15" Background="#FF1B3150" />
                            <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="#FF93A9C3" Margin="3" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF04141F" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="24" Background="{StaticResource PrimaryBrush}" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#FF0C1D2F" BlurRadius="40" ShadowDepth="0" Opacity="0.9" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.ColumnSpan="2" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Lina Optimizer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="  ✨" FontSize="22" />
                    <TextBlock Text="{Binding Tagline}" Margin="12,6,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ToggleButton x:Name="SimToggle" Content="Simulação / Simulation" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" />
                    <Button x:Name="MinimizeButton" Content="—" Width="32" Height="32" Margin="0,0,8,0" />
                    <Button x:Name="CloseButton" Content="✕" Width="32" Height="32" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" x:Name="SideMenu" Margin="0,20,16,0">
                <Button Style="{StaticResource SideButton}" Content="Dashboard / Painel" Tag="Tab:0" />
                <Button Style="{StaticResource SideButton}" Content="Sistema / System" Tag="Tab:1" />
                <Button Style="{StaticResource SideButton}" Content="Jogos / Games" Tag="Tab:2" />
                <Button Style="{StaticResource SideButton}" Content="Rede / Network" Tag="Tab:3" />
                <Button Style="{StaticResource SideButton}" Content="Debloat" Tag="Tab:4" />
                <Button Style="{StaticResource SideButton}" Content="Kernel / Boot" Tag="Tab:5" />
                <Button Style="{StaticResource SideButton}" Content="Energia / Power" Tag="Tab:6" />
                <Button Style="{StaticResource SideButton}" Content="Backup" Tag="Tab:7" />
                <Button Style="{StaticResource SideButton}" Content="Avançado / Advanced" Tag="Tab:8" />
                <Button Style="{StaticResource SideButton}" Content="Discord" Tag="Tab:9" />
            </StackPanel>

            <TabControl Grid.Row="1" Grid.Column="1" x:Name="MainTabs" Margin="0,20,0,0" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Smart Detection / Detecção Inteligente" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding SystemInfo}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="ContinueButton" Content="▶ Continuar / Continue" Style="{StaticResource PrimaryButton}" Width="220" Margin="8" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Sistema / System" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding SystemTweaks}" x:Name="SystemTweaksPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="320">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                <ToggleButton Tag="{Binding Key}" Style="{StaticResource ToggleStyle}" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Jogos / Games" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding GameList}" x:Name="GamesPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="360">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DetectLabel}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="Otimizar / Optimize" Tag="Optimize" CommandParameter="{Binding Key}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                                    <Button Content="Resetar / Reset" Tag="Reset" CommandParameter="{Binding Key}" Style="{StaticResource PrimaryButton}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Rede / Network" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding NetworkTweaks}" x:Name="NetworkTweaksPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="320">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                <ToggleButton Tag="{Binding Key}" Style="{StaticResource ToggleStyle}" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DebloatPanel">
                            <TextBlock Text="Debloat Windows" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Leve / Light" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Remoção segura com foco em apps básicos." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Aplicar / Apply" Tag="Debloat:Light" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Médio / Medium" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Balanceado para performance e estabilidade." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Aplicar / Apply" Tag="Debloat:Medium" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Nuclear / Extreme" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Remoção agressiva, use com cautela." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Aplicar / Apply" Tag="Debloat:Extreme" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Kernel / Boot" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding KernelTweaks}" x:Name="KernelTweaksPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="320">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                <ToggleButton Tag="{Binding Key}" Style="{StaticResource ToggleStyle}" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Energia / Power" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource CardStyle}" Width="360">
                                <StackPanel>
                                    <TextBlock Text="Plano Lina Max" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="CPU 100%, PCIe off, USB suspend off, GPU max." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <Button x:Name="PowerPlanButton" Content="Criar Plano / Create Plan" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BackupPanel">
                            <TextBlock Text="Backup" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Restore Point" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Criar ponto de restauração do Windows." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Criar / Create" Tag="RestorePoint" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Backup Registry" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Salvar registro em arquivo seguro." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Backup / Backup" Tag="BackupRegistry" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Backup Configs" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Salvar configs e perfis de jogos." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Backup / Backup" Tag="BackupConfigs" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="Restore All" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Restaurar backups e reverter tweaks." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button Content="Restaurar / Restore" Tag="RestoreAll" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Avançado / Advanced" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource CardStyle}" Width="420">
                                <StackPanel>
                                    <TextBlock Text="Modo Avançado" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Use os toggles nas abas para ajustes extremos." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Discord" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource CardStyle}" Width="360">
                                <StackPanel>
                                    <TextBlock Text="Comunidade Lina" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Entre no Discord oficial." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <Button x:Name="DiscordButton" Content="Entrar no Discord / Join Discord" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FF0B1424" CornerRadius="12" Padding="10" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            </Border>
        </Grid>
    </Border>
</Window>
