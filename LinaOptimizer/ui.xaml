<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lina Optimizer"
        Width="1280" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D0D0D"
        WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FF0D0D0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FF141414" />
        <SolidColorBrush x:Key="CardBrush" Color="#FF1B1B1B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF2A2A2A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3DA2FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFB0B0B0" />

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E1E1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2F8EDC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="13" Background="#FF2A2A2A" />
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Fill="#FFB0B0B0" Margin="2" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFFFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="HeaderTitle" Text="Lina Optimizer" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ComboBox x:Name="LanguageSelector" Width="160" Margin="0,0,12,0">
                        <ComboBoxItem Content="Português (BR)" Tag="pt-BR" IsSelected="True" />
                        <ComboBoxItem Content="English (US)" Tag="en-US" />
                    </ComboBox>
                    <ToggleButton x:Name="SimToggle" Content="Dry Run" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" />
                    <Button x:Name="MinimizeButton" Content="—" Width="32" Height="28" Margin="0,0,8,0" />
                    <Button x:Name="CloseButton" Content="✕" Width="32" Height="28" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel x:Name="SideMenu">
                    <Button x:Name="NavDashboard" Style="{StaticResource SidebarButton}" Tag="Tab:0" />
                    <Button x:Name="NavSystem" Style="{StaticResource SidebarButton}" Tag="Tab:1" />
                    <Button x:Name="NavGames" Style="{StaticResource SidebarButton}" Tag="Tab:2" />
                    <Button x:Name="NavNetwork" Style="{StaticResource SidebarButton}" Tag="Tab:3" />
                    <Button x:Name="NavDebloat" Style="{StaticResource SidebarButton}" Tag="Tab:4" />
                    <Button x:Name="NavKernel" Style="{StaticResource SidebarButton}" Tag="Tab:5" />
                    <Button x:Name="NavPower" Style="{StaticResource SidebarButton}" Tag="Tab:6" />
                    <Button x:Name="NavBackup" Style="{StaticResource SidebarButton}" Tag="Tab:7" />
                    <Button x:Name="NavAdvanced" Style="{StaticResource SidebarButton}" Tag="Tab:8" />
                    <Button x:Name="NavDiscord" Style="{StaticResource SidebarButton}" Tag="Tab:9" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.Resources>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DashboardTitle" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Border Style="{StaticResource CardStyle}" Width="280">
                                        <StackPanel>
                                            <TextBlock x:Name="HealthScoreLabel" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Dashboard.HealthScore}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding Dashboard.HealthMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock x:Name="AlertsLabel" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <ItemsControl ItemsSource="{Binding Dashboard.Alerts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="• {Binding}" Style="{StaticResource MutedText}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock x:Name="DetectionLabel" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <ItemsControl ItemsSource="{Binding SystemInfo}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                            <TextBlock Text="{Binding Value}" Style="{StaticResource MutedText}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <Button x:Name="OptimizeAllButton" Style="{StaticResource PrimaryButton}" Width="200" Margin="8" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="SystemTitle" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding SystemTweaks}" x:Name="SystemTweaksPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Width="360">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}" />
                                                        <TextBlock Text=" | " Style="{StaticResource MutedText}" />
                                                        <TextBlock Text="{Binding Risk}" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                    <ToggleButton Tag="{Binding Key}" Style="{StaticResource ToggleStyle}" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="GamesTitle" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding GameList}" x:Name="GamesPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Width="380">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DetectLabel}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="{Binding DataContext.GameActions.Optimize, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="Optimize" CommandParameter="{Binding Key}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                                    <Button Content="{Binding DataContext.GameActions.Reset, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="Reset" CommandParameter="{Binding Key}" Style="{StaticResource PrimaryButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="NetworkTitle" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding NetworkTweaks}" x:Name="NetworkTweaksPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Width="320">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <ToggleButton Tag="{Binding Key}" Style="{StaticResource ToggleStyle}" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DebloatPanel">
                                <TextBlock x:Name="DebloatTitle" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DebloatModes[0].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding DebloatModes[0].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Apply, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="Debloat:Light" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DebloatModes[1].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding DebloatModes[1].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Apply, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="Debloat:Medium" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DebloatModes[2].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding DebloatModes[2].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Apply, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="Debloat:Extreme" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="KernelTitle" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding KernelTweaks}" x:Name="KernelTweaksPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Width="320">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <ToggleButton Tag="{Binding Key}" Style="{StaticResource ToggleStyle}" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="PowerTitle" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource CardStyle}" Width="360">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PowerPlan.Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding PowerPlan.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <Button x:Name="PowerPlanButton" Content="{Binding ButtonLabels.Create}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BackupPanel">
                                <TextBlock x:Name="BackupTitle" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BackupActions[0].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding BackupActions[0].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Create, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="RestorePoint" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BackupActions[1].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding BackupActions[1].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Backup, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="BackupRegistry" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BackupActions[2].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding BackupActions[2].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Backup, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="BackupConfigs" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="320">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BackupActions[3].Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding BackupActions[3].Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Restore, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="RestoreAll" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AdvancedPanel">
                                <TextBlock x:Name="AdvancedTitle" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock Text="Process Lasso" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding AdvancedActions.ProcessLasso}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Open, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="ProcessLasso" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock Text="NVIDIA Profile Inspector" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding AdvancedActions.NvidiaInspector}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Open, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="NvidiaInspector" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock Text="Unpark CPU" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding AdvancedActions.UnparkCPU}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Open, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="UnparkCPU" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock Text="ParkControl" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding AdvancedActions.ParkControl}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Open, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="ParkControl" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Width="360">
                                        <StackPanel>
                                            <TextBlock Text="Discord Debloat" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding AdvancedActions.DiscordDebloat}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                            <Button Content="{Binding DataContext.ButtonLabels.Run, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="DiscordDebloat" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DiscordTitle" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource CardStyle}" Width="360">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DiscordCard.Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding DiscordCard.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <Button x:Name="DiscordButton" Content="{Binding ButtonLabels.Open}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FF151515" CornerRadius="6" Padding="8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" FontFamily="Segoe UI" />
            </Border>
        </Grid>
    </Border>
</Window>
